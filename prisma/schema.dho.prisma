model TradeGoods {
  id          Int     @id @db.Int
  name        String? @db.Text
  description String? @db.Text
  category    String? @db.Text
  culture     String? @db.Text
  jp          Int?    @db.Int
  ko          Int?    @db.Int
  tw          Int?    @db.Int
  ch          Int?    @db.Int

  @@map("tradegoods")
}

model TreasureMap {
  id             Int     @id @default(autoincrement()) @db.Int
  name           String? @db.VarChar(255)
  description    String? @db.Text
  requiredSkill  String? @map("required_skill") @db.VarChar(255)
  category       String? @db.VarChar(255)
  academicField  String? @map("academic_field") @db.VarChar(255)
  library        String? @db.VarChar(255)
  destination    String? @db.VarChar(255)
  discovery      Int?    @db.Int
  cityConditions String? @map("city_conditions") @db.Text
  preceding      String? @db.Text
  rewardDukat    Int?    @map("reward_dukat") @db.Int
  rewardItem     String? @map("reward_item") @db.Text
