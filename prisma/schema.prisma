generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              Int                 @id @default(autoincrement())
  email           String              @unique
  name            String?
  createdAt       DateTime            @default(now())

  totpConfirmedAt DateTime?
  totpEnabled     Boolean             @default(false)
  totpSecretEnc   String?

  totpLastStep    BigInt?

  passwordHash    String?
  passkeys        PasskeyCredential[]
  posts           Post[]
  recoveryCodes   UserRecoveryCode[]
}

// OTP 복구용
model UserRecoveryCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String   @db.VarChar(128)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([codeHash])
}


model PasskeyCredential {
  id           Int       @id @default(autoincrement())
  userId       Int
  credentialId Bytes     @unique
  publicKey    Bytes
  counter      Int       @default(0)
  name         String?
  transports   String?

  deviceType   String?   // "singleDevice" | "multiDevice"
  backedUp     Boolean?  // true/false

  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  
  depth       Int      @default(0)
  
  order       Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  posts       Post[]
  
  @@index([parentId])
  @@index([order])
}

model Tag {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  name  String
  posts Post[] @relation("PostToTag")
}

model File {
  id             String  @id @default(cuid())
  storage        String  // "s3" | "r2" | "local"
  bucket         String?
  objectKey      String  // 스토리지 경로/키
  
  originalName   String?
  storedName     String? // 🆕 추가
  mimeType       String?
  sizeBytes      BigInt?
  checksumSha256 String?

  width       Int?
  height      Int?
  durationSec Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt 
  deletedAt DateTime?

  postLinks PostFile[]
  projectThumbnails Project[]
  projectImages     ProjectImage[]

  @@index([storage, objectKey])
  @@index([createdAt])
}


model Comment {
  id             Int       @id @default(autoincrement())
  postId         Int
  parentId       Int?
  authorName     String
  authorEmail    String?
  authorHomepage String?
  authorPassword String    @default("legacy-comment")
  authorIp       String?   @db.VarChar(45)
  content        String    @db.Text
  isSecret       Boolean   @default(false)
  isApproved     Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  parent         Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[] @relation("CommentReplies")
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorEmail])
  @@index([isApproved, isDeleted])
}

model Trackback {
  id         Int      @id @default(autoincrement())
  postId     Int
  url        String   @db.VarChar(500)
  title      String?
  excerpt    String?  @db.Text
  blogName   String?
  isApproved Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([isApproved, isDeleted])
}

model Post {
  id             Int         @id @default(autoincrement())
  title          String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  authorId       Int
  categoryId     Int?
  contentHtml    String?     @db.LongText
  contentMd      String      @db.LongText
  publishedAt    DateTime?
  state          PostState   @default(DRAFT)

  placeName      String?     @map("place_name") @db.VarChar(200)
  address        String?     @db.VarChar(500)
  lat            Float?
  lng            Float?
  mapOnly        Boolean     @default(false) @map("map_only")

  
  commentCount   Int         @default(0)
  trackbackCount Int         @default(0)
  comments       Comment[]
  author         User        @relation(fields: [authorId], references: [id])
  category       Category?   @relation(fields: [categoryId], references: [id])
  files          PostFile[]
  trackbacks     Trackback[]
  tags           Tag[]       @relation("PostToTag")

  @@index([state, createdAt])
  @@index([authorId, createdAt])
  @@index([categoryId])
  @@index([lat, lng])
}

model PostFile {
  postId Int
  fileId String
  role   String?
  sort   Int     @default(0)
  alt    String?
  file   File    @relation(fields: [fileId], references: [id])
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, fileId])
  @@index([fileId])
  @@index([postId, role, sort])
}

model ProjectImage {
  projectId Int
  fileId    String
  sort      Int     @default(0)
  alt       String?
  file      File    @relation(fields: [fileId], references: [id])
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, fileId])
  @@index([fileId])
  @@index([projectId, sort])
}

model PageVisit {
  id               String   @id @default(cuid())
  visitorId        String   @map("visitor_id")
  sessionId        String   @map("session_id")
  pagePath         String   @map("page_path") @db.VarChar(500)
  referrer         String   @db.VarChar(500)
  userAgent        String?  @map("user_agent") @db.Text
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  country          String?  @db.VarChar(100)
  city             String?  @db.VarChar(100)
  deviceType       String?  @map("device_type") @db.VarChar(50)
  browser          String?  @db.VarChar(100)
  os               String?  @db.VarChar(100)
  screenResolution String?  @map("screen_resolution") @db.VarChar(50)
  language         String?  @db.VarChar(10)
  visitedAt        DateTime @default(now()) @map("visited_at")

  @@index([visitedAt])
  @@index([pagePath])
  @@index([visitorId])
  @@index([sessionId])
  @@map("page_visits")
}

enum PostState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// s4(포트폴리오) 프로젝트 카드. 코드 재배포 없이 Prisma Studio로 추가/수정하기 위해 DB로 뺌.
model Project {
  id           Int      @id @default(autoincrement())
  slug         String   @unique // 기존 하드코딩의 id("p2025c" 등)와 대응, 프론트 key로도 사용
  emoji        String   @db.VarChar(16)
  title        String   @db.VarChar(200)
  subtitle     String   @db.VarChar(500)
  category     String   @db.VarChar(50) // FilterKey("Web"|"App"|"PHP"|"Node.js" 등)과 매칭
  color        String   @db.VarChar(20) // hex
  period       String   @db.VarChar(50)
  contribution String   @db.VarChar(50)
  url          String?  @db.VarChar(500)
  github       String?  @db.VarChar(500)
  body         String   @db.Text
  stack        Json // { label: string; items: string[] }[]
  year         Int?
  tags         Json? // string[]
  order        Int      @default(0)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  thumbnailId String?
  thumbnail   File?   @relation(fields: [thumbnailId], references: [id])
  images      ProjectImage[]

  @@index([order])
  @@index([thumbnailId])
  @@map("projects")
}
