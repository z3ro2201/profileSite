generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              Int                 @id @default(autoincrement())
  email           String              @unique
  name            String?
  createdAt       DateTime            @default(now())
  totpConfirmedAt DateTime?
  totpEnabled     Boolean             @default(false)
  totpSecretEnc   String?
  passwordHash    String?
  passkeys        PasskeyCredential[]
  posts           Post[]
}

model PasskeyCredential {
  id           Int       @id @default(autoincrement())
  userId       Int
  credentialId Bytes     @unique
  publicKey    Bytes
  counter      Int       @default(0)
  name         String?
  transports   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  name     String
  description String?

  order    Int    @default(0)
  isPublic Boolean @default(true)

  posts    Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Tag {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  name  String
  posts Post[] @relation("PostToTag")
}

model File {
  id             String  @id @default(cuid())
  storage        String // "s3" | "r2" | "local"
  bucket         String?
  objectKey      String // 스토리지 경로/키
  originalName   String?
  mimeType       String?
  sizeBytes      BigInt?
  checksumSha256 String? // 중복/무결성 체크용(선택)

  width       Int? // 이미지면
  height      Int?
  durationSec Int? // 영상/오디오면

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  postLinks PostFile[]
}


model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  parentId  Int?     // 대댓글인 경우 부모 댓글 ID
  
  // 작성자 정보
  authorName     String
  authorEmail    String?
  authorHomepage String?
  authorPassword String   @default("legacy-comment") 
  authorIp       String?  @db.VarChar(45)
  
  // 댓글 내용
  content   String   @db.Text
  isSecret  Boolean  @default(false) // 비밀댓글 여부
  
  // 상태
  isApproved Boolean  @default(true)  // 승인 여부
  isDeleted  Boolean  @default(false) // 삭제 여부
  
  // 시간
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 관계
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
  
  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorEmail])
  @@index([isApproved, isDeleted])
}

model Trackback {
  id        Int      @id @default(autoincrement())
  postId    Int
  
  // 트랙백 정보
  url       String   @db.VarChar(500)  // 트랙백을 보낸 글의 URL
  title     String?                     // 트랙백을 보낸 글의 제목
  excerpt   String?  @db.Text          // 발췌문
  blogName  String?                     // 블로그 이름
  
  // 상태
  isApproved Boolean  @default(false)  // 스팸 방지를 위해 기본 false
  isDeleted  Boolean  @default(false)
  
  // 시간
  createdAt DateTime @default(now())
  
  // 관계
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@index([postId, createdAt])
  @@index([isApproved, isDeleted])
}


model Post {
  id          Int        @id @default(autoincrement())
  title       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    Int
  categoryId  Int?
  contentHtml String?    @db.LongText
  contentMd   String     @db.LongText
  publishedAt DateTime?
  state       PostState  @default(DRAFT)
  author      User       @relation(fields: [authorId], references: [id])
  category    Category?  @relation(fields: [categoryId], references: [id])
  tags        Tag[]      @relation("PostToTag")
  lat         Float?
  lng         Float?
  files       PostFile[]
  comments   Comment[]
  trackbacks Trackback[]
  commentCount   Int @default(0)
  trackbackCount Int @default(0)

  @@index([state, createdAt])
  @@index([authorId, createdAt])
  @@index([categoryId])
  @@index([lat, lng])
}

model PostFile {
  postId Int
  fileId String
  role   String?
  sort   Int     @default(0)
  alt    String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([postId, fileId])
  @@index([fileId])
  @@index([postId, role, sort])
}

enum PostState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PageVisit {
  id                String   @id @default(cuid())
  visitorId         String   @map("visitor_id")
  sessionId         String   @map("session_id")
  pagePath          String   @map("page_path") @db.VarChar(500)
  referrer          String   @db.VarChar(500)
  userAgent         String?  @map("user_agent") @db.Text
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  country           String?  @db.VarChar(100)
  city              String?  @db.VarChar(100)
  deviceType        String?  @map("device_type") @db.VarChar(50)
  browser           String?  @db.VarChar(100)
  os                String?  @db.VarChar(100)
  screenResolution  String?  @map("screen_resolution") @db.VarChar(50)
  language          String?  @db.VarChar(10)
  visitedAt         DateTime @default(now()) @map("visited_at")

  @@index([visitedAt])
  @@index([pagePath])
  @@index([visitorId])
  @@index([sessionId])
  @@map("page_visits")
}
